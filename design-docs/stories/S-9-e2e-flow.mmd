flowchart TB
    subgraph CI["GitHub Actions — ci.yml (JDK 21, single job)"]
        direction TB
        M["mvn -B verify\n(unit + slice tests, incl. AC-2/AC-13/AC-20 backend gaps)"]
        PKG["mvn -B package -DskipTests\n(build boot jar)"]
        BOOT["java -jar target/*.jar\n--spring.profiles.active=e2e\n(H2 in-memory, port 8080)"]
        SEED["E2eDataSeeder (@Profile e2e)\ndeterministic providers, availability rules,\ntime-off exception, appointments, a bookable window"]
        NPM["npx playwright test\n(Chromium, baseURL http://localhost:8080)"]
        REPORT["upload playwright-report/ + traces\n(on failure) as CI artifacts"]
        M --> PKG --> BOOT
        BOOT --> SEED
        SEED --> NPM --> REPORT
    end

    subgraph APP["Spring Boot app under test (e2e profile)"]
        LOGIN["/login form\nadmin@clinic.com / password123"]
        CAL["/admin/calendar\nThymeleaf shell + scheduling.js"]
        API["/api/appointments · /api/availability\n/api/appointment-series (JSON)"]
        LOGIN --> CAL
        CAL <--> API
    end

    subgraph SPECS["Playwright specs — backend/e2e/"]
        direction TB
        F["fixtures.ts\nauthenticated 'page' fixture (storageState),\nselector helpers, seed constants"]
