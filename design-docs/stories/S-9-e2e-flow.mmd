        S2["provider-filter.spec.ts  (AC-5)"]
        S3["appointment-block.spec.ts  (AC-6)"]
        S4["availability.spec.ts  (AC-7/8)"]
        S5["recurrence.spec.ts  (recurrence editor)"]
        S6["booking-flow.spec.ts  (book + refusal)"]
        F --> S1 & S2 & S3 & S4 & S5 & S6
    end

    NPM -.drives.-> LOGIN
    SPECS -.assert against.-> APP

